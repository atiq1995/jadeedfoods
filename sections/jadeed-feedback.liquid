<section class="jf-page-content">
  <div class="jf-container" style="max-width:640px;">
    <h2 class="jf-section__heading jf-section__heading--navy" style="font-size:40px;">{{ section.settings.heading }}</h2>
    {% if section.settings.intro != blank %}
      <p>{{ section.settings.intro }}</p>
    {% endif %}
    {%- form 'contact', id: 'JadeedFeedbackForm' -%}
      <input type="hidden" name="contact[tags]" value="feedback">
      <div class="field"><input class="field__input" type="text" name="contact[name]" placeholder="Your name" required></div>
      <div class="field"><input class="field__input" type="email" name="contact[email]" placeholder="Email" required></div>
      <div class="field"><textarea class="field__input" name="contact[body]" rows="6" placeholder="Your feedback" required></textarea></div>
      <button type="submit" class="jf-btn">{{ section.settings.button_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Feedback form",
  "tag": "section",
  "class": "section-jadeed-feedback",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Share your feedback" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Submit feedback" }
  ],
  "presets": [{ "name": "Feedback form" }]
}
{% endschema %}
