<footer class="jf-footer">
  <div class="jf-footer__main page-width">
    <div class="jf-footer__grid">
      <div class="jf-footer__col">
        <h2 class="jf-footer__heading">{{ section.settings.about_heading }}</h2>
        {% if section.settings.about_text != blank %}
          <div class="jf-footer__text">{{ section.settings.about_text }}</div>
        {% endif %}
        {% if section.settings.address != blank %}
          <p class="jf-footer__meta">
            <svg class="jf-footer__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 22s7-7.2 7-12a7 7 0 1 0-14 0c0 4.8 7 12 7 12z" stroke="currentColor" stroke-width="1.6"/>
              <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            <span>{{ section.settings.address }}</span>
          </p>
        {% endif %}
        {% if section.settings.email != blank %}
          <p class="jf-footer__meta">
            <svg class="jf-footer__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </p>
        {% endif %}
        {% if section.settings.phone != blank %}
          <p class="jf-footer__meta">
            <svg class="jf-footer__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v3A2 2 0 0 1 18 19 15 15 0 0 1 3.5 4.5a2 2 0 0 1 3-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
            <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a>
          </p>
        {% endif %}
      </div>

      <div class="jf-footer__col">
        <h2 class="jf-footer__heading">{{ section.settings.quick_heading }}</h2>
        <ul class="jf-footer__links">
          {% for block in section.blocks %}
            {% if block.type == 'quick_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="jf-footer__col">
        <h2 class="jf-footer__heading">{{ section.settings.company_heading }}</h2>
        <ul class="jf-footer__links">
          {% for block in section.blocks %}
            {% if block.type == 'company_link' %}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="jf-footer__col">
        <h2 class="jf-footer__heading">{{ section.settings.instagram_heading }}</h2>
        <div class="jf-footer__insta-grid">
          {% assign insta_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'instagram' %}
              {% assign insta_index = insta_index | plus: 1 %}
              {% liquid
                assign thumb = block.settings.image
                assign thumb_url = ''
                if thumb != blank
                  assign thumb_url = thumb | image_url: width: 220
                else
                  assign default_key = 'insta_' | append: insta_index
                  capture thumb_url
                    render 'jadeed-asset-url', key: default_key
                  endcapture
                  assign thumb_url = thumb_url | strip
                endif
              %}
              <a
                href="{{ section.settings.instagram_url | default: 'https://instagram.com' }}"
                class="jf-footer__insta-item"
                target="_blank"
                rel="noopener"
                {{ block.shopify_attributes }}
              >
                {% if thumb_url != blank %}
                  <img src="{{ thumb_url }}" alt="" width="103" height="103" loading="lazy">
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="jf-footer__bottom">
    <div class="jf-footer__bottom-inner page-width">
      <p class="jf-footer__copyright">{{ section.settings.copyright }}</p>
      {% if section.settings.show_social %}
        <div class="jf-footer__social">
          <a href="{{ settings.social_instagram_link | default: '#' }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6.5-.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/></svg>
          </a>
          <a href="{{ settings.social_twitter_link | default: '#' }}" aria-label="Twitter">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h5.2l4 5.7L17.8 3H21l-6.7 7.7L21 21h-5.2l-4.3-6.1L6.2 21H3l7-8.1L3 3z"/></svg>
          </a>
          <a href="{{ settings.social_facebook_link | default: '#' }}" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg>
          </a>
          <a href="{{ settings.social_youtube_link | default: '#' }}" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 12s0-3.4-.4-5a3 3 0 0 0-2.1-2.1C18.7 4.4 12 4.4 12 4.4s-6.7 0-8.5.5A3 3 0 0 0 1.4 7C1 8.6 1 12 1 12s0 3.4.4 5a3 3 0 0 0 2.1 2.1c1.8.5 8.5.5 8.5.5s6.7 0 8.5-.5a3 3 0 0 0 2.1-2.1c.4-1.6.4-5 .4-5zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Jadeed footer",
  "tag": "section",
  "class": "section-jadeed-footer",
  "settings": [
    { "type": "text", "id": "about_heading", "label": "About heading", "default": "About Us" },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>Jadeed Foods brings purity you can trust and taste you'll love — rice, spices, and cooking oil crafted with care.</p>"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "53-C, Satellite Town, Chandni Chowk, Murree Road, Rawalpindi, Pakistan."
    },
    { "type": "text", "id": "email", "label": "Email", "default": "web@jadeedfoods.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+92-51-111-JADEED" },
    { "type": "text", "id": "quick_heading", "label": "Quick links heading", "default": "Quick Links" },
    { "type": "text", "id": "company_heading", "label": "Company heading", "default": "Company" },
    { "type": "text", "id": "instagram_heading", "label": "Instagram heading", "default": "Follow on Instagram" },
    { "type": "url", "id": "instagram_url", "label": "Instagram profile URL" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "2025 Jadeed Foods. All Rights Reserved" },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Policy" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    },
    {
      "type": "company_link",
      "name": "Company link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "About Us" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    },
    {
      "type": "instagram",
      "name": "Instagram thumbnail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [{ "name": "Jadeed footer" }]
}
{% endschema %}
