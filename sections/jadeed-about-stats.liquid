<section class="jf-about-stats">
  <div class="jf-about-stats__inner">
    <div class="jf-about-stats__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign icon_key = 'stat_box'
          assign icon_w = 100
          assign icon_h = 94
          case block.settings.icon
            when 'store'
              assign icon_key = 'stat_store'
              assign icon_w = 89
              assign icon_h = 80
            when 'bag'
              assign icon_key = 'stat_bag'
              assign icon_w = 96
              assign icon_h = 81
            when 'money'
              assign icon_key = 'stat_money'
              assign icon_w = 95
              assign icon_h = 80
          endcase
        -%}
        {%- capture icon_url -%}{% render 'jadeed-asset-url', key: icon_key %}{%- endcapture -%}
        <div class="jf-about-stats__item" {{ block.shopify_attributes }}>
          <div class="jf-about-stats__icon jf-about-stats__icon--{{ block.settings.icon }}" aria-hidden="true">
            <img
              src="{{ icon_url | strip }}"
              alt=""
              width="{{ icon_w }}"
              height="{{ icon_h }}"
              loading="lazy"
            >
          </div>
          <p class="jf-about-stats__value">{{ block.settings.value }}</p>
          <p class="jf-about-stats__label">{{ block.settings.label }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About stats",
  "tag": "section",
  "class": "section-jadeed-about-stats",
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "box", "label": "Box" },
            { "value": "store", "label": "Store" },
            { "value": "bag", "label": "Bag" },
            { "value": "money", "label": "Money" }
          ],
          "default": "box"
        },
        { "type": "text", "id": "value", "label": "Value", "default": "45M" },
        { "type": "text", "id": "label", "label": "Label", "default": "Products for sale" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About stats",
      "blocks": [
        { "type": "stat", "settings": { "icon": "box", "value": "45M", "label": "Products for sale" } },
        { "type": "stat", "settings": { "icon": "store", "value": "1.8M", "label": "Sellers on Jadeed Foods" } },
        { "type": "stat", "settings": { "icon": "bag", "value": "30.6M", "label": "Buyers on Jadeed Foods" } },
        { "type": "stat", "settings": { "icon": "money", "value": "Rs 2.64M", "label": "Annual gross sales" } }
      ]
    }
  ]
}
{% endschema %}
