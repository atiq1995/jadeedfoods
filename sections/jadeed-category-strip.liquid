<section class="jf-category-strip">
  <div class="jf-container">
    <nav class="jf-category-strip__nav" aria-label="Product categories">
      {% for block in section.blocks %}
        {% liquid
          assign link_url = block.settings.link
          if link_url == blank and block.settings.collection != blank
            assign link_url = block.settings.collection.url
          endif
          if link_url == blank
            assign link_url = '/collections/' | append: block.settings.label | handle
          endif

          assign icon_key = block.settings.icon
          if icon_key == blank
            assign icon_key = block.settings.label | handle
          endif
          assign icon_asset = 'icon_' | append: icon_key
          capture icon_url
            render 'jadeed-asset-url', key: icon_asset
          endcapture
          assign icon_url = icon_url | strip

          assign label_handle = block.settings.label | handle
          assign is_active = false
          if collection != blank and block.settings.collection != blank and collection.handle == block.settings.collection.handle
            assign is_active = true
          elsif collection != blank and collection.handle == label_handle
            assign is_active = true
          elsif request.path == link_url
            assign is_active = true
          endif
        %}
        <a
          href="{{ link_url }}"
          class="jf-category-strip__tab{% if is_active %} is-active{% endif %}"
          {% if is_active %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="jf-category-strip__icon" aria-hidden="true">
            {% if icon_url != blank %}
              <img
                src="{{ icon_url }}"
                alt=""
                width="48"
                height="48"
                loading="lazy"
              >
            {% endif %}
          </span>
          <span class="jf-category-strip__label">{{ block.settings.label }}</span>
        </a>
      {% endfor %}
    </nav>

    <div class="jf-category-strip__row">
      {% for block in section.blocks %}
        {% liquid
          assign link_url = block.settings.link
          if link_url == blank and block.settings.collection != blank
            assign link_url = block.settings.collection.url
          endif
          if link_url == blank
            assign link_url = '/collections/' | append: block.settings.label | handle
          endif
          assign img_url = ''
          if block.settings.image != blank
            assign img_url = block.settings.image | image_url: width: 720
          elsif block.settings.asset_key != blank
            capture img_url
              render 'jadeed-asset-url', key: block.settings.asset_key
            endcapture
            assign img_url = img_url | strip
          endif
        %}
        <a href="{{ link_url }}" class="jf-category-strip__item" {{ block.shopify_attributes }}>
          <span class="jf-category-strip__media">
            {% if img_url != blank %}
              <img src="{{ img_url }}" alt="{{ block.settings.label | escape }}" width="280" height="280" loading="lazy">
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category strip",
  "tag": "section",
  "class": "section-jadeed-category-strip",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Oil" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "oil", "label": "Oil drops" },
            { "value": "rice", "label": "Rice sack" },
            { "value": "spices", "label": "Mortar and pestle" }
          ],
          "default": "oil"
        },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "asset_key",
          "label": "Fallback asset key",
          "info": "e.g. plp_oil, plp_rice, plp_spices"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category strip",
      "blocks": [
        { "type": "category", "settings": { "label": "Oil", "icon": "oil", "asset_key": "plp_oil" } },
        { "type": "category", "settings": { "label": "Rice", "icon": "rice", "asset_key": "plp_rice" } },
        { "type": "category", "settings": { "label": "Spices", "icon": "spices", "asset_key": "plp_spices" } }
      ]
    }
  ]
}
{% endschema %}
