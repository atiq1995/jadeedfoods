<section class="jf-pdp-reviews section-{{ section.id }}-padding">
  <div class="jf-container">
    <div class="jf-pdp-reviews__head">
      <h2 class="jf-pdp-reviews__title">{{ section.settings.heading }}</h2>
      <div class="jf-pdp-reviews__controls-top">
        <label class="jf-pdp-reviews__sort">
          <span class="visually-hidden">Sort reviews</span>
          <select class="jf-pdp-reviews__select" aria-label="Sort reviews">
            <option>{{ section.settings.sort_label | default: 'Most Recent' }}</option>
          </select>
        </label>
        <div class="jf-pdp-reviews__arrows" data-jf-pdp-reviews-arrows>
          <button type="button" class="jf-pdp-reviews__arrow" data-dir="prev" aria-label="Previous review">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" class="jf-pdp-reviews__arrow" data-dir="next" aria-label="Next review">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="jf-pdp-reviews__stage" data-jf-pdp-reviews-carousel>
      {%- for block in section.blocks -%}
        <article
          class="jf-pdp-review-card{% if forloop.index == 2 %} is-center{% endif %}"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="jf-pdp-review-card__stars" aria-label="{{ block.settings.rating | default: 5 }} out of 5 stars">
            {%- for i in (1..5) -%}<span aria-hidden="true">★</span>{%- endfor -%}
            <span class="jf-pdp-review-card__count">({{ block.settings.rating_count | default: '4k+' }})</span>
          </div>
          <p class="jf-pdp-review-card__quote">{{ block.settings.quote }}</p>
          <div class="jf-pdp-review-card__author">
            {%- if block.settings.avatar != blank -%}
              {{
                block.settings.avatar
                | image_url: width: 80
                | image_tag: class: 'jf-pdp-review-card__avatar', loading: 'lazy', alt: ''
              }}
            {%- else -%}
              <span class="jf-pdp-review-card__avatar jf-pdp-review-card__avatar--placeholder" aria-hidden="true"></span>
            {%- endif -%}
            <div>
              <p class="jf-pdp-review-card__name">{{ block.settings.name }}</p>
              <p class="jf-pdp-review-card__date">{{ block.settings.date }}</p>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="jf-pdp-reviews__dots" role="tablist" aria-label="Reviews">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="jf-pdp-reviews__dot{% if forloop.index == 2 %} is-active{% endif %}"
            data-dot="{{ forloop.index0 }}"
            aria-label="Show review {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <p class="jf-pdp-reviews__cta">
        <button type="button" class="jf-pdp-reviews__write-btn" data-jf-feedback-open>
          {{ section.settings.button_label }}
        </button>
      </p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'jadeed-pdp.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Jadeed product reviews",
  "tag": "section",
  "class": "section-jadeed-product-reviews",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "text", "id": "sort_label", "label": "Sort label", "default": "Most Recent" },
    { "type": "text", "id": "button_label", "label": "Write review button", "default": "Write a review" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." },
        { "type": "text", "id": "name", "label": "Name", "default": "Mark Jones" },
        { "type": "text", "id": "date", "label": "Date", "default": "14th May 2022" },
        { "type": "text", "id": "rating_count", "label": "Rating count label", "default": "4k+" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Stars" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Jadeed product reviews",
      "blocks": [
        { "type": "review", "settings": { "name": "Mark Jones", "date": "14th May 2022" } },
        { "type": "review", "settings": { "name": "Sarah Ali", "date": "2nd Apr 2022" } },
        { "type": "review", "settings": { "name": "Ahmed Khan", "date": "18th Jun 2022" } }
      ]
    }
  ]
}
{% endschema %}
