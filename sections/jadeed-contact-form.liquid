<section class="jf-contact-form-wrap">
  <div class="jf-container">
    <h2 class="jf-contact-form__heading">{{ section.settings.heading }}</h2>
    <div class="jf-contact-form-card">
      {%- form 'contact', id: 'JadeedContactPageForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{ 'templates.contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {% if form.errors %}
          <div class="form__message">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="jf-contact-form-card__row">
          <div class="field">
            <input class="field__input" type="text" id="JadeedContactName" name="contact[name]" placeholder="Name*" value="{% if form.name %}{{ form.name }}{% endif %}" required>
          </div>
          <div class="field">
            <input class="field__input" type="email" id="JadeedContactEmail" name="contact[email]" placeholder="Email*" value="{% if form.email %}{{ form.email }}{% endif %}" required>
          </div>
        </div>
        <div class="field">
          <input class="field__input" type="text" id="JadeedContactSubject" name="contact[subject]" placeholder="Subject (optional)">
        </div>
        <div class="field">
          <textarea class="field__input" id="JadeedContactMessage" name="contact[body]" rows="8" placeholder="Message" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>
        <button type="submit" class="jf-btn">{{ section.settings.button_label }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact card form",
  "tag": "section",
  "class": "section-jadeed-contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Post comment" }
  ],
  "presets": [{ "name": "Contact card form" }]
}
{% endschema %}
