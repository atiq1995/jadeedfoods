<section class="jf-contact-form-wrap" id="contact-form">
  <div class="jf-container">
    <h2 class="jf-contact-form__heading">{{ section.settings.heading }}</h2>
    <div class="jf-contact-form-card">
      {%- form 'contact', id: 'JadeedContactPageForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{ 'templates.contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {% if form.errors %}
          <div class="form__message">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="jf-contact-form-card__row">
          <div class="jf-contact-field">
            <label class="visually-hidden" for="JadeedContactName">Name</label>
            <input class="jf-contact-field__input" type="text" id="JadeedContactName" name="contact[name]" placeholder="Name*" autocomplete="name" value="{% if form.name %}{{ form.name }}{% endif %}" required>
          </div>
          <div class="jf-contact-field">
            <label class="visually-hidden" for="JadeedContactEmail">Email</label>
            <input class="jf-contact-field__input" type="email" id="JadeedContactEmail" name="contact[email]" placeholder="Email*" autocomplete="email" value="{% if form.email %}{{ form.email }}{% endif %}" required>
          </div>
        </div>
        <div class="jf-contact-field">
          <label class="visually-hidden" for="JadeedContactSubject">Subject (optional)</label>
          <input class="jf-contact-field__input" type="text" id="JadeedContactSubject" name="contact[subject]" placeholder="Subject (Optional)">
        </div>
        <div class="jf-contact-field jf-contact-field--message">
          <label class="visually-hidden" for="JadeedContactMessage">Message</label>
          <textarea class="jf-contact-field__input" id="JadeedContactMessage" name="contact[body]" rows="8" placeholder="Message" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>
        <div class="jf-contact-form-card__actions">
          <button type="submit" class="jf-btn jf-btn--navy">{{ section.settings.button_label }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact card form",
  "tag": "section",
  "class": "section-jadeed-contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Post comment" }
  ],
  "presets": [{ "name": "Contact card form" }]
}
{% endschema %}
