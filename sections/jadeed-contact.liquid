<section class="jf-contact-grid">
  <div>
    <h2 class="jf-section__heading jf-section__heading--navy" style="text-align:left;font-size:40px;margin-bottom:24px;">Contact Us</h2>
    <p>{{ section.settings.intro }}</p>
    <p><strong>Address:</strong> {{ section.settings.address }}</p>
    <p><strong>Phone:</strong> {{ section.settings.phone }}</p>
    <p><strong>Email:</strong> {{ section.settings.email }}</p>
  </div>
  <div>
    {%- form 'contact', id: 'JadeedContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p>{{ 'templates.contact.form.post_success' | t }}</p>
      {%- endif -%}
      <div class="field">
        <input class="field__input" type="text" name="contact[name]" placeholder="Name" required>
      </div>
      <div class="field">
        <input class="field__input" type="email" name="contact[email]" placeholder="Email" required>
      </div>
      <div class="field">
        <textarea class="field__input" name="contact[body]" rows="5" placeholder="Message" required></textarea>
      </div>
      <button type="submit" class="jf-btn">Send message</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-jadeed-contact",
  "settings": [
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "We'd love to hear from you. Send us a message and we'll respond as soon as we can." },
    { "type": "text", "id": "address", "label": "Address", "default": "53-C, Satellite Town, Chandni Chowk, Murree Road, Rawalpindi, Pakistan." },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+92-51-111-JADEED" },
    { "type": "text", "id": "email", "label": "Email", "default": "web@jadeedfoods.com" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
