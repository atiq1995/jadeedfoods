<section class="jf-section jf-section--navy">
  <div class="jf-container">
    <h2 class="jf-section__heading">{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="jf-section__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="jf-product-grid">
      {% assign default_keys = 'product_rice,product_spices,product_oil' | split: ',' %}
      {% for block in section.blocks %}
        {% liquid
          assign card_title = block.settings.title
          assign card_desc = block.settings.description
          assign card_link = block.settings.link
          assign card_bg_url = ''
          assign default_key = default_keys[forloop.index0]

          if block.settings.product != blank
            assign prod = block.settings.product
            if card_title == blank
              assign card_title = prod.title
            endif
            if card_link == blank
              assign card_link = prod.url
            endif
            if card_desc == blank and prod.description != blank
              assign card_desc = prod.description | strip_html | truncate: 120
            endif
            if block.settings.image == blank and prod.featured_media
              assign card_bg_url = prod.featured_media.preview_image | image_url: width: 800
            endif
          endif

          if block.settings.image != blank
            assign card_bg_url = block.settings.image | image_url: width: 800
          elsif card_bg_url == blank and default_key != blank
            capture card_bg_url
              render 'jadeed-asset-url', key: default_key
            endcapture
            assign card_bg_url = card_bg_url | strip
          endif
        %}
        <a
          href="{{ card_link | default: '#' }}"
          class="jf-card jf-card--product"
          style="{% if card_bg_url != blank %}background-image:url('{{ card_bg_url }}');{% endif %} background-color:#1a2a5c;"
          {{ block.shopify_attributes }}
        >
          <div class="jf-card__body">
            <span class="jf-card__title jf-card__title--product">{{ card_title }}</span>
            {% if card_desc != blank %}
              <span class="jf-card__text">{{ card_desc }}</span>
            {% endif %}
            <span class="jf-arrow-btn" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best selling products",
  "tag": "section",
  "class": "section-jadeed-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Selling Products" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "product_tile",
      "name": "Product tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title", "default": "BEST SELLING RICE" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [{ "name": "Best selling products" }]
}
{% endschema %}
