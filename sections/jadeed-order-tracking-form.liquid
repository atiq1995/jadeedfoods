{% liquid
  assign hero_style = ''
  if section.settings.image != blank
    assign hero_image = section.settings.image | image_url: width: 2400
    assign hero_style = 'background-image: url(' | append: "'" | append: hero_image | append: "');"
  endif
%}

<section
  class="jf-order-tracking-page{% if hero_style != blank %} jf-order-tracking-page--has-bg{% endif %}"
  {% if hero_style != blank %}
    style="{{ hero_style }}"
  {% endif %}
>
  {% if hero_style != blank %}
    <div class="jf-order-tracking-page__overlay"></div>
  {% endif %}
  <div class="jf-container jf-order-tracking-page__inner">
    <h1 class="jf-order-tracking-page__title">{{ section.settings.title | default: page.title }}</h1>

    <div class="jf-order-tracking-page__card">
      {% if section.settings.instructions != blank %}
        <p class="jf-order-tracking-page__intro">{{ section.settings.instructions }}</p>
      {% endif %}

      <form action="{{ section.settings.form_action | default: routes.account_login_url }}" method="get" class="jf-order-tracking-form">
        <div class="jf-order-tracking-form__field">
          <label for="JadeedOrderId-{{ section.id }}">{{ section.settings.order_label }}</label>
          <input
            id="JadeedOrderId-{{ section.id }}"
            class="jf-order-tracking-form__input"
            type="text"
            name="order_id"
            placeholder="{{ section.settings.order_placeholder }}"
            autocomplete="off"
            required
          >
        </div>

        <div class="jf-order-tracking-form__field">
          <label for="JadeedBillingEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
          <input
            id="JadeedBillingEmail-{{ section.id }}"
            class="jf-order-tracking-form__input"
            type="email"
            name="billing_email"
            placeholder="{{ section.settings.email_placeholder }}"
            autocomplete="email"
            required
          >
        </div>

        <button type="submit" class="jf-order-tracking-form__submit">{{ section.settings.button_label }}</button>
      </form>

      {% if section.settings.note != blank and section.settings.show_note %}
        <p class="jf-order-tracking-page__note">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order tracking page",
  "tag": "section",
  "class": "section-jadeed-order-tracking-form",
  "settings": [
    { "type": "text", "id": "title", "label": "Page title", "default": "Order Tracking" },
    {
      "type": "textarea",
      "id": "instructions",
      "label": "Instructions",
      "default": "To track your order please enter your Order ID in the box below and press the \"Track\" button. This is given in your receipt and in the confirmation email you should have received."
    },
    { "type": "text", "id": "order_label", "label": "Order field label", "default": "Order ID" },
    { "type": "text", "id": "order_placeholder", "label": "Order field placeholder", "default": "Found in your order confirmation email." },
    { "type": "text", "id": "email_label", "label": "Email field label", "default": "Billing email" },
    { "type": "text", "id": "email_placeholder", "label": "Email field placeholder", "default": "Email you used during checkout." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Track your order" },
    { "type": "url", "id": "form_action", "label": "Form action URL" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image override",
      "info": "Optional. Leave empty for the solid red background from the design."
    },
    { "type": "checkbox", "id": "show_note", "label": "Show developer note", "default": false },
    { "type": "text", "id": "note", "label": "Developer note", "default": "Connect this form to your order-tracking app endpoint." }
  ],
  "presets": [{ "name": "Order tracking page" }]
}
{% endschema %}
