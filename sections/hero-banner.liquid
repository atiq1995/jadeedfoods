{% liquid
  assign hero_bg = ''
  if section.settings.background_image != blank
    assign hero_bg = section.settings.background_image | image_url: width: 2400
  else
    assign hero_bg = 'jadeed-hero-bg.png' | asset_url
  endif
%}
<section class="jf-hero"{% if section.settings.title != blank %} aria-label="{{ section.settings.title | escape }}"{% endif %}>
  <img
    class="jf-hero__media"
    src="{{ hero_bg }}"
    alt=""
    width="1729"
    height="797"
  >
  <div class="jf-container">
    <div class="jf-hero__content">
      {% if section.settings.title != blank %}
        <h1 class="jf-hero__title">{{ section.settings.title }}</h1>
      {% else %}
        <h1 class="visually-hidden">Jadeed Foods</h1>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="jf-hero__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="jf-btn" style="margin-top:32px;">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
  <div class="jf-hero__notch" aria-hidden="true">
    <svg viewBox="0 0 1729 125.032" preserveAspectRatio="none" focusable="false">
      <path d="M0 0 H633.725 C659.523 0 684.763 7.502 706.372 21.593 L806.556 86.921 C842.077 110.084 887.925 110.084 923.446 86.921 L1023.63 21.593 C1045.24 7.502 1070.48 0 1096.28 0 H1729 V125.032 H0 Z"></path>
    </svg>
  </div>
  <a class="jf-hero__scroll" href="#shop-by-category" aria-label="Scroll to shop by category">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <polyline points="6 13 12 19 18 13"></polyline>
    </svg>
  </a>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-jadeed-hero",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Flavors Made to Be Remembered" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
