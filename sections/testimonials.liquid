<section class="jf-testimonials-wrap">
  <div class="jf-testimonials-lockup">
    <p class="jf-testimonials-lockup__it">{{ section.settings.lockup_prefix | default: 'It has to be' }}</p>
    <div class="jf-testimonials-lockup__brand">
      <img
        class="jf-testimonials-lockup__logo"
        src="{{ 'jadeed-logo.png' | asset_url }}"
        alt="Jadeed Foods"
        width="280"
        height="161"
        loading="lazy"
      >
      <p class="jf-testimonials-lockup__foods">
        <span class="jf-testimonials-lockup__rule" aria-hidden="true"></span>
        <span>{{ section.settings.lockup_suffix | default: 'Foods' }}</span>
        <span class="jf-testimonials-lockup__rule" aria-hidden="true"></span>
      </p>
    </div>
  </div>

  <div class="jf-testimonial-banner">
    <h2 class="jf-testimonial-banner__section-title">{{ section.settings.heading }}</h2>

    <div class="jf-testimonial" data-testimonial-carousel>
      {% for block in section.blocks %}
        <div class="jf-testimonial__slide" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="jf-testimonial__stars" aria-label="5 out of 5 stars">
            <span aria-hidden="true">★</span><span aria-hidden="true">★</span><span aria-hidden="true">★</span><span aria-hidden="true">★</span><span aria-hidden="true">★</span>
          </div>
          <p class="jf-testimonial__quote">{{ block.settings.quote }}</p>
          <p class="jf-testimonial__name">{{ block.settings.name }}</p>
        </div>
      {% endfor %}

      {% if section.blocks.size > 0 %}
        <div class="jf-testimonial__controls">
          <div class="jf-testimonial__dots" role="tablist" aria-label="Testimonials">
            {% for block in section.blocks %}
              <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Show testimonial {{ forloop.index }}"></button>
            {% endfor %}
          </div>
          <div class="jf-testimonial__divider" aria-hidden="true"></div>
          <div class="jf-testimonial__arrows">
            <button type="button" class="jf-testimonial__arrow" data-dir="prev" aria-label="Previous testimonial">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="jf-testimonial__arrow" data-dir="next" aria-label="Next testimonial">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    const carousels = document.querySelectorAll('[data-testimonial-carousel]');
    carousels.forEach(function (carousel) {
      if (carousel.dataset.bound) return;
      carousel.dataset.bound = '1';
      const slides = carousel.querySelectorAll('.jf-testimonial__slide');
      const dots = carousel.querySelectorAll('[data-dot]');
      const prev = carousel.querySelector('[data-dir="prev"]');
      const next = carousel.querySelector('[data-dir="next"]');
      let index = 0;
      function show(i) {
        if (!slides.length) return;
        index = (i + slides.length) % slides.length;
        slides.forEach(function (s, n) { s.hidden = n !== index; });
        dots.forEach(function (d, n) { d.classList.toggle('is-active', n === index); });
      }
      dots.forEach(function (dot) {
        dot.addEventListener('click', function () { show(parseInt(dot.dataset.dot, 10)); });
      });
      if (prev) prev.addEventListener('click', function () { show(index - 1); });
      if (next) next.addEventListener('click', function () { show(index + 1); });
      if (slides.length > 1) setInterval(function () { show(index + 1); }, 6000);
    });
  })();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-jadeed-testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Testimonials" },
    { "type": "text", "id": "lockup_prefix", "label": "Lockup prefix", "default": "It has to be" },
    { "type": "text", "id": "lockup_suffix", "label": "Lockup suffix", "default": "Foods" },
    { "type": "image_picker", "id": "logo", "label": "Logo override" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I absolutely love Jadeed Cooking Oil! It's not only great for heart health but also perfect for those who are health-conscious. While it may be a bit pricier, your health is invaluable, and taking care of your body is essential—we only have one life to live. I enjoy cooking with this oil, everything turns out delicious and perfectly cooked. It's a fantastic choice for anyone who values their well-being!"
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Gregory Huang" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
