{% liquid
  assign man_url = 'jadeed-about-pillars-man.png' | asset_url
  assign woman_url = 'jadeed-about-pillars-woman.png' | asset_url
  assign seeds_tr_url = 'jadeed-about-pillars-seeds.svg' | asset_url
  assign seeds_mid_url = 'jadeed-about-pillars-seeds-mid.svg' | asset_url
  if section.settings.image_man != blank
    assign man_url = section.settings.image_man | image_url: width: 900
  endif
  if section.settings.image_woman != blank
    assign woman_url = section.settings.image_woman | image_url: width: 900
  endif
%}

<section class="jf-about-pillars">
  <div class="jf-container jf-about-pillars__grid">
    <div class="jf-about-pillars__media" aria-hidden="true">
      <div class="jf-about-pillars__stack">
        <span
          class="jf-about-pillars__dots jf-about-pillars__dots--tr"
          style="--jf-seeds: url('{{ seeds_tr_url }}');"
        ></span>
        <span
          class="jf-about-pillars__dots jf-about-pillars__dots--mid"
          style="--jf-seeds: url('{{ seeds_mid_url }}');"
        ></span>
        <div class="jf-about-pillars__frame jf-about-pillars__frame--man">
          <img
            src="{{ man_url }}"
            alt=""
            width="1024"
            height="819"
            loading="lazy"
          >
        </div>
        <div class="jf-about-pillars__frame jf-about-pillars__frame--woman">
          <img
            src="{{ woman_url }}"
            alt=""
            width="1024"
            height="819"
            loading="lazy"
          >
        </div>
      </div>
    </div>
    <div class="jf-about-pillars__content">
      <h2 class="jf-about-pillars__title">
        <span class="jf-about-pillars__lead">{{ section.settings.lead_text }}</span>
        <span class="jf-about-pillars__hl">{{ section.settings.highlight_1 }}, {{ section.settings.highlight_2 }},</span>
        <span class="jf-about-pillars__row">
          <span class="jf-about-pillars__and">{{ section.settings.and_text }}</span>
          <span class="jf-about-pillars__hl">{{ section.settings.highlight_3 }}</span>
        </span>
      </h2>
      <ul class="jf-about-pillars__list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            {{ block.settings.title }}: {{ block.settings.text }}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About pillars",
  "tag": "section",
  "class": "section-jadeed-about-pillars",
  "settings": [
    { "type": "image_picker", "id": "image_man", "label": "Top photo override" },
    { "type": "image_picker", "id": "image_woman", "label": "Bottom photo override" },
    { "type": "text", "id": "lead_text", "label": "Lead text", "default": "We stand for" },
    { "type": "text", "id": "highlight_1", "label": "Highlight 1", "default": "Purity" },
    { "type": "text", "id": "highlight_2", "label": "Highlight 2", "default": "Innovation" },
    { "type": "text", "id": "and_text", "label": "And text", "default": "and" },
    { "type": "text", "id": "highlight_3", "label": "Highlight 3", "default": "Collaboration" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Purity" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sourcing the finest natural ingredients." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Purity", "text": "Sourcing the finest natural ingredients." } },
        { "type": "pillar", "settings": { "title": "Innovation", "text": "Consistent product improvement and process advancement." } },
        { "type": "pillar", "settings": { "title": "Collaboration", "text": "Building trusted partnerships with distributors and retailers across markets." } }
      ]
    }
  ]
}
{% endschema %}
