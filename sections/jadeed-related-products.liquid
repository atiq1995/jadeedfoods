{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="jf-pdp-related section-{{ section.id }}-padding">
  <div class="jf-container">
    <div class="jf-pdp-related__head">
      <h2 class="jf-pdp-related__title">{{ section.settings.heading }}</h2>
      <div class="jf-pdp-related__arrows" data-jf-pdp-related-arrows>
        <button type="button" class="jf-pdp-related__arrow" data-dir="prev" aria-label="Previous products">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="jf-pdp-related__arrow" data-dir="next" aria-label="Next products">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <product-recommendations
      class="jf-pdp-related__track-wrap"
      data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="jf-pdp-related__track" data-jf-pdp-related-track role="list">
          {%- for recommendation in recommendations.products -%}
            <div class="jf-pdp-related__slide" role="listitem">
              {% render 'jadeed-related-product-card',
                card_product: recommendation,
                button_label: section.settings.button_label
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="jf-pdp-related__track" data-jf-pdp-related-track role="list">
          {%- for i in (1..4) -%}
            <div class="jf-pdp-related__slide" role="listitem">
              {% render 'jadeed-related-product-card',
                card_product: product,
                button_label: section.settings.button_label
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-recommendations>
  </div>
</section>

<script src="{{ 'jadeed-pdp.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Jadeed related products",
  "tag": "section",
  "class": "section-jadeed-related-products",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Related Products" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "default": 4, "label": "Products to show" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy Now" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding bottom", "default": 36 }
  ],
  "presets": [{ "name": "Jadeed related products" }]
}
{% endschema %}
