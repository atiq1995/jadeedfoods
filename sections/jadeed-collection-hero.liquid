{% liquid
  assign hero_bg = ''
  assign collection_handle = collection.handle | default: ''

  if section.settings.image != blank
    assign hero_bg = section.settings.image | image_url: width: 2400
  elsif collection_handle == 'rice'
    assign hero_bg = 'Web-banner-rice-2.png' | asset_url
  elsif collection_handle == 'spices' or collection_handle == 'spice'
    assign hero_bg = 'Web-banner-spices.png' | asset_url
  elsif collection_handle == 'oil'
    # Temporary until client delivers the Oil banner
    assign hero_bg = 'Web-banner.png' | asset_url
  else
    capture hero_bg
      render 'jadeed-asset-url', key: 'collection_hero'
    endcapture
    assign hero_bg = hero_bg | strip
  endif

  assign hero_title = section.settings.title
  if section.settings.use_collection_title and collection != blank
    assign hero_title = collection.title
  endif

  assign show_text = false
  if hero_title != blank or section.settings.subtitle != blank
    assign show_text = true
  endif

  assign is_category_banner = false
  if collection_handle == 'rice' or collection_handle == 'spices' or collection_handle == 'spice' or collection_handle == 'oil'
    assign is_category_banner = true
  endif
%}

<section
  class="jf-collection-hero{% unless show_text %} jf-collection-hero--photo{% endunless %}{% if is_category_banner %} jf-collection-hero--web-banner{% endif %}"
  {% if hero_bg != blank %}style="background-image:url('{{ hero_bg }}');"{% endif %}
  {% if collection != blank %}aria-label="{{ collection.title | escape }}"{% endif %}
>
  {% if show_text %}
    <div class="jf-container jf-collection-hero__inner">
      <div>
        {% if hero_title != blank %}
          <h1>{{ hero_title }}</h1>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "section-jadeed-collection-hero",
  "settings": [
    { "type": "checkbox", "id": "use_collection_title", "label": "Use collection title", "default": false },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "image_picker", "id": "image", "label": "Background image override" }
  ],
  "presets": [{ "name": "Collection hero" }]
}
{% endschema %}
