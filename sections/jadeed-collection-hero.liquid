{% liquid
  assign hero_bg = ''
  if section.settings.image != blank
    assign hero_bg = section.settings.image | image_url: width: 2400
  else
    capture hero_bg
      render 'jadeed-asset-url', key: 'collection_hero'
    endcapture
    assign hero_bg = hero_bg | strip
  endif
%}

<section class="jf-collection-hero" {% if hero_bg != blank %}style="background-image:url('{{ hero_bg }}');"{% endif %}>
  <div class="jf-container jf-collection-hero__inner">
    <div>
      <h1>
        {%- if section.settings.use_collection_title and collection != blank -%}
          {{ collection.title }}
        {%- else -%}
          {{ section.settings.title }}
        {%- endif -%}
      </h1>
      {% if section.settings.subtitle != blank %}
        <p>{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "section-jadeed-collection-hero",
  "settings": [
    { "type": "checkbox", "id": "use_collection_title", "label": "Use collection title", "default": false },
    { "type": "text", "id": "title", "label": "Title", "default": "Flavors made to be remembered" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Discover our premium range of rice, spices, and oils." },
    { "type": "image_picker", "id": "image", "label": "Background image override" }
  ],
  "presets": [{ "name": "Collection hero" }]
}
{% endschema %}
