{%- liquid
  if section.settings.button_link != blank
    assign faq_contact_href = section.settings.button_link
  elsif pages.contact.url != blank
    assign faq_contact_href = pages.contact.url | append: '#contact-form'
  else
    assign faq_contact_href = '/pages/contact#contact-form'
  endif
-%}
<section class="jf-faq-cta">
  <div class="jf-container">
    {% if section.settings.eyebrow != blank %}
      <p class="jf-faq-cta__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <a href="{{ faq_contact_href }}" class="jf-faq-cta__title">{{ section.settings.title }}</a>
  </div>
</section>

{% schema %}
{
  "name": "FAQ contact CTA",
  "tag": "section",
  "class": "section-jadeed-faq-cta",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here to help!" },
    { "type": "text", "id": "title", "label": "Title", "default": "Contact us" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "FAQ contact CTA" }]
}
{% endschema %}
