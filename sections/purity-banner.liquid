<section class="jf-purity" aria-label="{{ section.settings.word | escape }}">
  <div class="jf-purity__track" aria-live="polite">
    <p class="jf-purity__line jf-purity__line--word">{{ section.settings.word | upcase }}</p>
    <p class="jf-purity__line jf-purity__line--trust">
      <span class="jf-purity__line-flow jf-purity__line-flow--left" data-text="{{ section.settings.line_before | upcase }}">
        {{ section.settings.line_before | upcase }}
      </span>
    </p>
    <p class="jf-purity__line jf-purity__line--taste">
      <span class="jf-purity__line-flow jf-purity__line-flow--right" data-text="{{ section.settings.line_after | upcase }}">
        {{ section.settings.line_after | upcase }}
      </span>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Purity banner",
  "tag": "section",
  "class": "section-jadeed-purity",
  "settings": [
    { "type": "text", "id": "word", "label": "Large word", "default": "PURITY" },
    { "type": "text", "id": "line_before", "label": "Supporting line", "default": "you can trust," },
    { "type": "text", "id": "line_after", "label": "Accent line", "default": "taste you'll love!" }
  ],
  "presets": [{ "name": "Purity banner" }]
}
{% endschema %}
