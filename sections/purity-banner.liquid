<section class="jf-purity" aria-label="{{ section.settings.word | escape }}">
  <div class="jf-purity__track">
    {% for i in (1..2) %}
      <p class="jf-purity__line">
        <span class="jf-purity__before">{{ section.settings.line_before }}</span>
        <span class="jf-purity__word">{{ section.settings.word }}</span>
        <span class="jf-purity__after">{{ section.settings.line_after }}</span>
      </p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Purity banner",
  "tag": "section",
  "class": "section-jadeed-purity",
  "settings": [
    { "type": "text", "id": "word", "label": "Large word", "default": "PURITY" },
    { "type": "text", "id": "line_before", "label": "Supporting line", "default": "you can trust," },
    { "type": "text", "id": "line_after", "label": "Accent line", "default": "taste you'll love!" }
  ],
  "presets": [{ "name": "Purity banner" }]
}
{% endschema %}
