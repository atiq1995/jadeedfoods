{% liquid
  assign bg_url = ''
  if section.settings.image != blank
    assign bg_url = section.settings.image | image_url: width: 2400
  else
    assign bg_url = 'jadeed-lifestyle-clean.png' | asset_url
  endif
%}
<section class="jf-lifestyle" aria-label="{{ section.settings.heading | escape }}">
  {% if section.settings.heading != blank %}
    <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
  {% endif %}
  <img
    class="jf-lifestyle__base"
    src="{{ bg_url }}"
    alt=""
    width="1727"
    height="931"
    decoding="async"
  >
  <img
    class="jf-lifestyle__leaf"
    src="{{ 'jadeed-lifestyle-curve.png' | asset_url }}"
    alt=""
    width="1024"
    height="766"
    decoding="async"
    aria-hidden="true"
  >
</section>

{% schema %}
{
  "name": "Lifestyle banner",
  "tag": "section",
  "class": "section-jadeed-lifestyle",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Accessible heading", "default": "Friends enjoying Jadeed Foods" }
  ],
  "presets": [{ "name": "Lifestyle banner" }]
}
{% endschema %}
