{% liquid
  assign bg_url = ''
  if section.settings.image != blank
    assign bg_url = section.settings.image | image_url: width: 1920
  else
    assign bg_url = 'jadeed-lifestyle-group.jpg' | asset_url
  endif
%}
<section class="jf-lifestyle" style="background-image:url('{{ bg_url }}');" aria-label="{{ section.settings.heading | escape }}">
  {% if section.settings.heading != blank %}
    <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
  {% endif %}
</section>

{% schema %}
{
  "name": "Lifestyle banner",
  "tag": "section",
  "class": "section-jadeed-lifestyle",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Accessible heading", "default": "Friends enjoying Jadeed Foods" }
  ],
  "presets": [{ "name": "Lifestyle banner" }]
}
{% endschema %}
