<section class="jf-about-timeline">
  <p class="jf-about-timeline__discover">{{ section.settings.discover_label }}</p>

  <div class="jf-about-timeline__banner" aria-hidden="true">
    <p class="jf-about-timeline__banner-text">
      <span>{{ section.settings.banner_left }}</span>
      <span class="jf-about-timeline__banner-accent">{{ section.settings.banner_accent }}</span>
      <span>{{ section.settings.banner_right }}</span>
    </p>
  </div>

  {% liquid
    assign timeline_url = ''
    if section.settings.image != blank
      assign timeline_url = section.settings.image | image_url: width: 2400
    else
      capture timeline_url
        render 'jadeed-asset-url', key: 'about_timeline'
      endcapture
      assign timeline_url = timeline_url | strip
    endif
  %}

  {% if timeline_url != blank %}
    {%- comment -%}
      Desktop: full Figma graphic (cards + path) for pixel match.
      Mobile: three clipped slices of the same graphic, stacked vertically.
    {%- endcomment -%}
    <div class="jf-about-timeline__figure-wrap jf-about-timeline__figure-wrap--desktop">
      <figure class="jf-about-timeline__figure">
        <img
          src="{{ timeline_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          loading="lazy"
          width="1611"
          height="555"
        >
      </figure>
    </div>

    <div
      class="jf-about-timeline__cards jf-about-timeline__cards--mobile"
      style="--jf-timeline-src: url('{{ timeline_url }}');"
      role="list"
      aria-label="{{ section.settings.image_alt | escape }}"
    >
      <div
        class="jf-about-timeline__slice jf-about-timeline__slice--1"
        role="listitem"
        aria-label="February 2012"
      ></div>
      <div
        class="jf-about-timeline__slice jf-about-timeline__slice--2"
        role="listitem"
        aria-label="July 2015"
      ></div>
      <div
        class="jf-about-timeline__slice jf-about-timeline__slice--3"
        role="listitem"
        aria-label="September 2015"
      ></div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "About timeline",
  "tag": "section",
  "class": "section-jadeed-about-timeline",
  "settings": [
    { "type": "text", "id": "discover_label", "label": "Discover label", "default": "Discover" },
    { "type": "text", "id": "banner_left", "label": "Banner left", "default": "Jadeed Foods" },
    { "type": "text", "id": "banner_accent", "label": "Banner accent", "default": "Journey" },
    { "type": "text", "id": "banner_right", "label": "Banner right", "default": "Jadeed Foods Journey" },
    { "type": "image_picker", "id": "image", "label": "Timeline graphic override" },
    { "type": "text", "id": "image_alt", "label": "Timeline image alt", "default": "Jadeed Foods journey timeline" }
  ],
  "presets": [
    {
      "name": "About timeline"
    }
  ]
}
{% endschema %}
