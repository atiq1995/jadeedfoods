{% liquid
  assign hero_image = ''
  if section.settings.image != blank
    assign hero_image = section.settings.image | image_url: width: 2400
  elsif section.settings.asset_key != blank
    capture hero_image
      render 'jadeed-asset-url', key: section.settings.asset_key
    endcapture
    assign hero_image = hero_image | strip
  endif
%}

<section
  class="jf-page-hero-image{% if section.settings.overlay %} jf-page-hero-image--overlay{% endif %}{% if section.settings.title == blank and section.settings.subtitle == blank %} jf-page-hero-image--photo{% endif %}"
  {% if hero_image != blank %}
    style="background-image:url('{{ hero_image }}');"
  {% endif %}
>
  {% if section.settings.title != blank or section.settings.subtitle != blank %}
    <div class="jf-container">
      {% if section.settings.title != blank %}
        <h1 class="jf-page-hero-image__title">{{ section.settings.title }}</h1>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="jf-page-hero-image__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Page hero image",
  "tag": "section",
  "class": "section-jadeed-page-hero-image",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "About Us" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "checkbox", "id": "overlay", "label": "Dark overlay", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "text", "id": "asset_key", "label": "Default asset key", "default": "about_hero" }
  ],
  "presets": [{ "name": "Page hero image" }]
}
{% endschema %}
