{%- comment -%}
  Free Delivery badge — always use the Figma lockup SVG.
  Custom delivery_icon uploads (product photos) break the header layout.
{%- endcomment -%}
<div class="jf-delivery-badge jf-delivery-badge--lockup">
  <img
    class="jf-delivery-badge__lockup"
    src="{{ 'jadeed-free-delivery.svg' | asset_url }}"
    alt="{{ section.settings.delivery_label | default: 'FREE DELIVERY' }} {{ section.settings.delivery_value | default: 'Upto Order of Rs. 4999' }}"
    width="299"
    height="41"
    loading="eager"
  >
</div>
